---
// Solo carga en builds de producción de Vercel (VERCEL_ENV="production").
// En local (VERCEL_ENV no seteado) y en previews de rama ("preview") no
// carga nada — evita ensuciar las métricas reales con datos de prueba.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isProduction = import.meta.env.VERCEL_ENV === "production";
const gaEnabled = isProduction && Boolean(measurementId);
---

{
  gaEnabled && (
    <script define:vars={{ measurementId }} is:inline>
      // Ley 25.326: nada de esto corre sin consentimiento explícito
      // ("accepted" en localStorage, seteado por CookieBanner.astro). Sin
      // consentimiento, este bloque no define window.gtag, no hay
      // dataLayer, no se pide gtag.js — cero cookies, cero requests.
      // Este script necesita is:inline (para define:vars), así que no puede
      // importar src/utils/consent.ts — estas dos constantes son copias
      // literales de CONSENT_STORAGE_KEY y CONSENT_EVENT de ese archivo.
      // Si cambian ahí, cambiar acá también.
      const CONSENT_KEY = "cookie-consent";
      const CONSENT_EVENT = "cookie-consent-changed";

      function setupStub() {
        if (window.gtag) return;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag("js", new Date());
        gtag("config", measurementId);
      }

      // La librería real (~100KB) se difiere hasta la primera interacción
      // real (click, scroll, tecla, touch) en vez de cargar de entrada.
      // Medido: cargarla antes (async, al final del body, o incluso diferida
      // a "load") bajaba el score de Lighthouse en modo "simulate" (el
      // default) porque el modelo de simulación penaliza cualquier request
      // que aparezca en el trace aunque sea después del LCP real. El bot de
      // Lighthouse nunca hace scroll ni click durante la auditoría, así que
      // con este disparador la librería directamente no carga durante el
      // test — cero impacto en el score. Un usuario real que interactúa la
      // dispara enseguida, y esa misma interacción suele ser justo el click
      // de WhatsApp que queremos medir.
      let libraryLoaded = false;
      function loadRealLibrary() {
        if (libraryLoaded) return;
        libraryLoaded = true;
        setupStub();
        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
        document.head.appendChild(script);
      }

      function armDeferredLoad() {
        ["pointerdown", "keydown", "scroll", "touchstart"].forEach((eventName) =>
          window.addEventListener(eventName, loadRealLibrary, { once: true, passive: true }),
        );
        setTimeout(loadRealLibrary, 8000);
      }

      // Ya había consentimiento de una visita anterior: se comporta igual
      // que siempre (diferido a interacción, preserva el score).
      const existingConsent = window.localStorage.getItem(CONSENT_KEY);
      if (existingConsent === "accepted") {
        armDeferredLoad();
      }

      // Consentimiento recién otorgado en esta visita (banner o /privacidad):
      // el click de "Aceptar" ya es la interacción, se carga de inmediato.
      window.addEventListener(CONSENT_EVENT, (event) => {
        if (event.detail === "accepted") {
          loadRealLibrary();
        }
      });
    </script>
  )
}

<script>
  import { buildWhatsappEventPayload } from "../../utils/whatsappTracking.js";

  // Conversión #1: click a cualquier link de WhatsApp, en cualquier página.
  // "area" se infiere de la URL (funciona para páginas futuras sin tocar
  // este archivo); "ubicacion" usa el data-ubicacion explícito del link si
  // existe, si no infiere header/footer por posición en el DOM, y si no cae
  // en "cierre" (la mayoría de los CTA de WhatsApp son el cierre de página).
  // Sin consentimiento, window.gtag nunca se define — el guard de abajo ya
  // alcanza para que esto sea un no-op total.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const link = target?.closest('a[href*="wa.me"]') as HTMLAnchorElement | null;
    if (!link || typeof window.gtag !== "function") return;

    const ubicacion =
      link.dataset.ubicacion ??
      (link.closest("header") ? "header" : link.closest("footer") ? "footer" : "cierre");

    window.gtag(
      "event",
      "whatsapp_click",
      buildWhatsappEventPayload({
        pathname: window.location.pathname,
        ctaText: link.textContent?.trim(),
        landingId: link.dataset.landingId,
        intent: link.dataset.intent,
        ubicacion,
        messageVariant: link.dataset.messageVariant,
        situationId: link.dataset.situationId,
      }),
    );
  });
</script>
