---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Heading from "../components/ui/Heading.astro";
import Button from "../components/ui/Button.astro";

// TODO (Luciano): estructura en espera de borrador-politica-privacidad.md —
// nunca lo recibí en la conversación (lo busqué en el repo, no está). En
// cuanto lo pases, esto se reemplaza por los encabezados reales de las 10
// secciones. No redacto cláusulas legales ni completo los bloques
// [DECISIÓN]/[VERIFICAR] del borrador — eso es contenido tuyo, no mío.
---

<BaseLayout
  title="Política de Privacidad"
  description="Política de privacidad y protección de datos personales de Giovanardi Barili, conforme a la Ley 25.326."
>
  <section class="py-20 sm:py-28">
    <Container class="mx-auto max-w-[70ch]">
      <Heading as="h1" align="center" class="mx-auto text-center">
        Política de Privacidad
      </Heading>

      <div class="mx-auto mt-10 max-w-[65ch] rounded-xl border border-dashed border-accent-soft bg-accent-soft/10 p-6 text-sm text-ink-soft">
        <p class="font-semibold uppercase tracking-wide text-accent">Pendiente</p>
        <p class="mt-2">
          Esta página está armada como esqueleto funcional (revocación de
          consentimiento incluida) a la espera del contenido definitivo. Las
          10 secciones del borrador van acá, en el orden y con los
          encabezados que definas — no se inventa ni se redacta contenido
          legal.
        </p>
      </div>

      <div class="mt-12 space-y-3 text-ink-soft">
        <p>
          [Acá van las 10 secciones de <code>borrador-politica-privacidad.md</code>,
          cada una como su propio <code>&lt;h2&gt;</code>, en el mismo orden del
          borrador.]
        </p>
      </div>

      <div
        id="revoke-consent-section"
        class="mt-16 rounded-xl border border-border bg-surface-alt p-6"
      >
        <h2 class="font-serif text-xl text-primary">Cookies analíticas</h2>
        <p class="mt-2 text-sm text-ink-soft">
          Si en algún momento aceptaste cookies analíticas y querés dejar de
          compartir esa información, podés revocar el consentimiento cuando
          quieras. La página se recarga para que el cambio tenga efecto
          inmediato.
        </p>
        <div class="mt-4">
          <Button id="revoke-consent-button" type="button" variant="secondary">
            Revocar consentimiento de cookies
          </Button>
        </div>
        <p id="revoke-consent-status" role="status" aria-live="polite" class="mt-3 text-sm text-primary"></p>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { getConsent, setConsent } from "../utils/consent";

  const button = document.getElementById("revoke-consent-button");
  const status = document.getElementById("revoke-consent-status");

  if (button && status) {
    if (getConsent() !== "accepted") {
      button.setAttribute("disabled", "true");
      status.textContent = "Todavía no aceptaste cookies analíticas en este navegador — no hay nada que revocar.";
    }

    button.addEventListener("click", () => {
      setConsent("rejected");
      status.textContent = "Listo. Recargando la página...";
      window.location.reload();
    });
  }
</script>
